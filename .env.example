# Copy this file to .env.local and fill in your values from
# Supabase: Project Settings > API Keys. Only the publishable key goes here,
# never the secret key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Push reminders (optional; README.md > Push reminders). The PUBLIC half of
# the VAPID key pair; `npm run push-secrets` fills it in. The private half
# goes only to Supabase (as a function secret), never here.
VITE_VAPID_PUBLIC_KEY=
